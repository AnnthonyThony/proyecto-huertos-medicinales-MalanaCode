# Modifica todos los secretos antes de exponer el sistema.
DB_USER=kawsapacha
DB_NAME=kawsapacha
DB_PASSWORD=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST_REAL:5432/kawsapacha?schema=public"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_DE_AL_MENOS_32_CARACTERES
# Cuenta de administración para la primera instalación (crear y luego retirar la clave)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_ADMIN
PORT=3100
# true cuando Nginx termina HTTPS y envía X-Forwarded-Proto
TRUST_PROXY=false
# Déjalo vacío en HTTP local; true al servir por HTTPS detrás de Nginx
COOKIE_SECURE=false
# Puntos base de muestra: los PDF no definen este valor
POINTS_PER_ACTIVITY=10
# No activar en producción: fichas botánicas ficticias para pruebas locales
SEED_DEMO_PLANTS=false
